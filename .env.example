# ==========================
# MATCHPOINT Environment
# ==========================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=matchpoint
POSTGRES_USER=matchpoint
POSTGRES_PASSWORD=change_me

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=matchpoint_analytics
CLICKHOUSE_USER=matchpoint
CLICKHOUSE_PASSWORD=change_me

# Apache Airflow
AIRFLOW_PORT=8080

# FastAPI Backend
BACKEND_PORT=8000
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# React Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Project Settings
TZ=Africa/Cairo
# Durable collection recovery
SNAPSHOT_ENCRYPTION_KEY=
SNAPSHOT_DIRECTORY=.runtime/snapshots
