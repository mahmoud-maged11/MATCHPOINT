      "scopes": [
        "jobs",
        "lp_course"
      ],
      "checkpoint_enabled": true,
      "bootstrap_required": true,
      "overlap_minutes": 5,
      "safety_lag_minutes": 2,
      "live_incremental_acceptance": "partial",
      "storage": "postgres",
      "batch_size": 100,
      "max_jobs": null,
      "max_pages": null,
      "allow_partial_persistence": true,
      "allow_partial_checkpoint": false,
      "infer_closure_from_absence": false,
